{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/app",
      "destination": "https://www.spreadrun.com/",
      "statusCode": 301
    },
    {
      "source": "/app/:path*",
      "destination": "https://www.spreadrun.com/",
      "statusCode": 301
    },
    {
      "source": "/dscr-calculator",
      "destination": "https://www.spreadrun.com/",
      "statusCode": 301
    },
    {
      "source": "/flip-calculator",
      "destination": "https://www.spreadrun.com/",
      "statusCode": 301
    },
    {
      "source": "/rental-calculator",
      "destination": "https://www.spreadrun.com/",
      "statusCode": 301
    },
    {
      "source": "/guides/dscr-loan-calculator",
      "destination": "https://www.spreadrun.com/guides",
      "statusCode": 301
    },
    {
      "source": "/guides/rental-cash-flow-calculator",
      "destination": "https://www.spreadrun.com/guides",
      "statusCode": 301
    },
    {
      "source": "/guides/70-percent-rule-house-flipping",
      "destination": "https://www.spreadrun.com/guides",
      "statusCode": 301
    },
    {
      "source": "/guides/good-cap-rate-rental-property",
      "destination": "https://www.spreadrun.com/guides",
      "statusCode": 301
    },
    {
      "source": "/guides/how-to-analyze-rental-property",
      "destination": "https://www.spreadrun.com/guides",
      "statusCode": 301
    },
    {
      "source": "/guides/cleveland-rental-property-investing",
      "destination": "https://www.spreadrun.com/guides",
      "statusCode": 301
    },
    {
      "source": "/guides/indianapolis-rental-property-investing",
      "destination": "https://www.spreadrun.com/guides",
      "statusCode": 301
    },
    {
      "source": "/guides/columbus-rental-property-investing",
      "destination": "https://www.spreadrun.com/guides",
      "statusCode": 301
    },
    {
      "source": "/guides/real-estate-terms-glossary",
      "destination": "https://www.spreadrun.com/guides",
      "statusCode": 301
    },
    {
      "source": "/secondring",
      "destination": "https://www.spreadrun.com/",
      "statusCode": 301
    },
    {
      "source": "/guides/lsa-missed-call-charges-october-2026",
      "destination": "https://www.spreadrun.com/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "spreadrun.com"
        }
      ],
      "destination": "https://www.spreadrun.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/rent-estimate",
      "destination": "/api/retired"
    },
    {
      "source": "/api/early-access",
      "destination": "/api/retired"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "maxDuration": 30,
      "excludeFiles": "{node_modules/**,src/**,public/**,dist/**,docs/**,scripts/**,supabase/**,pylib/tests/**,api/_tests/**,**/__pycache__/**}"
    }
  },
  "headers": [
    {
      "source": "/account",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
